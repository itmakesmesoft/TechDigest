{
  "name": "tech-digest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "create-docs": "hygen generate docs",
    "postinstall": "husky",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ],
    "*.{md,json}": [
      "prettier --cache --write"
    ]
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@tailwindcss/postcss": "^4.1.6",
    "hygen": "^6.2.11",
    "next": "^15.1.7",
    "nextra": "^4.2.13",
    "nextra-theme-docs": "^4.2.13",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.6",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5"
  }
}
